rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function isOwner() {
      return signedIn() && request.auth.uid == resource.data.userId;
    }
    function createsOwned() {
      return signedIn() && request.auth.uid == request.resource.data.userId;
    }

    // every collection the app writes carries a userId field matching the auth uid
    match /subjects/{id} {
      allow read, update, delete: if isOwner();
      allow create: if createsOwned();
    }
    match /tasks/{id} {
      allow read, update, delete: if isOwner();
      allow create: if createsOwned();
    }
    match /resources/{id} {
      allow read, update, delete: if isOwner();
      allow create: if createsOwned();
    }
    match /availability/{uid} {
      allow read, update, delete: if isOwner();
      allow create: if createsOwned();
    }
    match /weeklyPlans/{id} {
      allow read, update, delete: if isOwner();
      allow create: if createsOwned();
    }
    // email reminders: written by the site, consumed by a scheduled Cloud Function
    match /mailQueue/{id} {
      allow read, update, delete: if isOwner();
      allow create: if createsOwned();
    }
  }
}
